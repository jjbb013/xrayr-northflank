# XrayR Northflank 配置模板
# 通过环境变量注入实际值

Log:
  Level: ${LOG_LEVEL:-info}
  AccessPath: /tmp/access.log
  ErrorPath: /tmp/error.log
  AccessConsole: true
  ErrorConsole: true

DnsConfigPath: /etc/XrayR/dns.json
RouteConfigPath: /etc/XrayR/route.json
OutboundConfigPath: /etc/XrayR/custom_outbound.json

ConnectionConfig:
  Handshake: 4
  ConnIdle: 30
  UplinkOnly: 2
  DownlinkOnly: 4
  BufferSize: 64

# Northflank 单容器多节点配置
# 所有节点共享同一个 XrayR 实例，通过不同端口区分
Nodes:
  # Node 14 (端口 10014)
  - PanelType: "NewV2board"
    ApiConfig:
      ApiHost: "${XBOARD_API_HOST}"
      ApiKey: "${XBOARD_API_KEY}"
      NodeID: 14
      NodeType: Shadowsocks
      Timeout: 30
      EnableVless: false
      SpeedLimit: 0
      DeviceLimit: 0
      DisableCustomConfig: false
    ControllerConfig:
      ListenIP: 0.0.0.0
      SendIP: 0.0.0.0
      UpdatePeriodic: 60
      EnableDNS: false
      DNSType: AsIs
      EnableProxyProtocol: false
      AutoSpeedLimitConfig:
        Limit: 0
        WarnTimes: 0
        LimitSpeed: 0
        LimitDuration: 0
      GlobalDeviceLimitConfig:
        Enable: false
      EnableFallback: false
      FallBackConfigs: []
      DisableLocalREALITYConfig: false
      EnableREALITY: false

