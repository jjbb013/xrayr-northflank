# XrayR Northflank 部署环境变量模板
# 复制为 .env 并填写实际值

# ========== 必填配置 ==========
# XBoard 面板地址 (例如: https://p01--xboard--xxxxx.code.run)
XBOARD_API_HOST=https://your-xboard-domain.com

# XBoard API Key
XBOARD_API_KEY=your-api-key-here

# 通用 UUID (所有节点共享)
OUTBOUND_UUID=3c4dd06f-7ede-47ba-b83d-ca16a023cc4f

# ========== 节点配置 (每个节点独立) ==========
# 每个节点在 Northflank 中创建独立的 Service
# 通过环境变量 NODE_ID 和 OUTBOUND_ADDRESS/OUTBOUND_PORT 区分

# 节点 84: 香港01 (HTTP)
NODE_ID=84
OUTBOUND_ADDRESS=yg1.ygkkk.dpdns.org
OUTBOUND_PORT=80
ENABLE_TLS=false

# 节点 85: 香港02 (HTTP)
# NODE_ID=85
# OUTBOUND_ADDRESS=yg2.ygkkk.dpdns.org
# OUTBOUND_PORT=8080

# ... 更多节点配置

# ========== 可选配置 ==========
# 节点类型 (Vless/Vmess/Shadowsocks/Trojan)
NODE_TYPE=Vless

# 面板类型 (NewV2board/SSpanel/V2board)
PANEL_TYPE=NewV2board

# 日志级别 (none/error/warning/info/debug)
LOG_LEVEL=warning

# 更新周期 (秒)
UPDATE_PERIODIC=60

# 监听地址
LISTEN_IP=0.0.0.0

# WebSocket 路径
OUTBOUND_PATH=/?ed=2560

# WebSocket Host
OUTBOUND_HOST=wboard.will-pan.workers.dev
